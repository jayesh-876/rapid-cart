  },
  "item": [
    {
      "name": "Order Service",
      "item": [
        {
          "name": "Create Order - Invalid Payload",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"\",\n  \"userId\": \"\",\n  \"quantity\": 0,\n  \"amount\": 0\n}"
            },
            "url": {
              "raw": "http://localhost:8081/orders",
              "host": ["http://localhost:8081"],
              "path": ["orders"]
            }
          }
        },
        {
          "name": "Create Order - Valid Payload",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"P1001\",\n  \"userId\": \"U1001\",\n  \"quantity\": 2,\n  \"amount\": 49.99\n}"
            },
            "url": {
              "raw": "http://localhost:8081/orders",
              "host": ["http://localhost:8081"],
              "path": ["orders"]
            }
          }
        },
        {
          "name": "Get Order - Not Found",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8081/orders/does-not-exist",
              "host": ["http://localhost:8081"],
              "path": ["orders", "does-not-exist"]
            }
          }
        }
      ]
    },
